rules_version = '2';

// ServiciosYa — Firestore Security Rules (US-130).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profile created on registration: users/{uid} = { name, email, role, createdAt }.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        // Nobody can self-assign another role (e.g. provider or admin) from the app.
        && request.resource.data.role == 'CLIENT'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Catalog data is loaded with the seed script (Admin SDK bypasses these rules).
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      // Demo: only the owner of the profile (userId == uid) can set featuredUntil.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['featuredUntil'])
        && request.resource.data.featuredUntil is timestamp;
      allow create, delete: if false;
    }

    // Plans bought through the simulated payment gateway. Demo only: the app writes its own plan,
    // so with real payments this has to move behind a backend that validates the purchase.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['adFree', 'featured', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        // adFree: { plan in [adfree_yearly, adfree_lifetime], expiresAt: null | timestamp }
        // featured: { plan in [featured_weekly|monthly|yearly], expiresAt: timestamp, trialEndsAt?: timestamp }
        && (!('adFree' in request.resource.data) || (request.resource.data.adFree.keys().hasOnly(['plan', 'expiresAt'])
            && request.resource.data.adFree.plan in ['adfree_yearly', 'adfree_lifetime']))
        && (!('featured' in request.resource.data) || (request.resource.data.featured.keys().hasOnly(['plan', 'expiresAt', 'trialEndsAt'])
            && request.resource.data.featured.plan in ['featured_weekly', 'featured_monthly', 'featured_yearly']));
      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      // Only the client who made the request can read it. List queries must filter
      // by clientId == auth.uid, which is what "Mis solicitudes" does.
      allow read: if isSignedIn() && resource.data.clientId == request.auth.uid;

      // The callable validates and creates requests with the Admin SDK.
      allow create: if false;

      // Status changes belong to a future provider/admin flow, not to the MVP client app.
      allow update, delete: if false;
    }
  }
}
